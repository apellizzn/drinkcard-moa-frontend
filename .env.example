# Used by vite.config.ts for the local /api dev proxy and ngrok host checks.
# In production the equivalent is `API_UPSTREAM_URL` in wrangler.jsonc, which
# the Worker reads at runtime to proxy /api/* server-side.
VITE_API_PROXY_TARGET=http://localhost:8080
# Optional: set when the proxy target is an IP/CDN endpoint that requires a specific Host header.
# VITE_API_PROXY_HOST=api.example.com
VITE_ALLOWED_HOSTS=uncharted-apply-upstart.ngrok-free.dev
