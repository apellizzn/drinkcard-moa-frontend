{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drinkcard-moa-frontend",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "logs": {
      "enabled": true
    }
  }
  // NOTE: `VITE_API_BASE_URL` is build-time (Vite inlines it during `vite build`).
  // Set it in the shell when deploying:
  //   VITE_API_BASE_URL=https://api.example.com bun run deploy
  // Putting it under `vars` here only exposes it to the Worker at runtime,
  // which is too late — the client bundle is already compiled.
}
